    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.access_token) {",
                  "  pm.collectionVariables.set('accessToken', data.access_token);",
                  "}",
                  "if (data.user && data.user.id) {",
                  "  pm.collectionVariables.set('createdUserId', String(data.user.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman-user-{{$timestamp}}@example.com\",\n  \"password\": \"password123\",\n  \"first_name\": \"Postman\",\n  \"last_name\": \"User\",\n  \"display_name\": \"Postman User\",\n  \"bio\": \"Created from the Postman collection.\",\n  \"avatar_url\": \"https://example.com/avatars/postman-user.png\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/{{apiPrefix}}/auth/register"
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.access_token) {",
